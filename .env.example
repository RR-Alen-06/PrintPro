# ==============================================================================
# PRINT-SERVICE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate with your Print-Service Supabase credentials.
#
# DO NOT COMMIT .env.local TO VERSION CONTROL
# ==============================================================================

# Public Supabase credentials for client-side queries
NEXT_PUBLIC_SUPABASE_URL=https://your-print-service-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-print-service-anon-key

# Server-side / API route Supabase environment variables (optional overrides)
SUPABASE_URL=https://your-print-service-ref.supabase.co
SUPABASE_ANON_KEY=your-print-service-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-print-service-service-role-key

